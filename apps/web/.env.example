# Database (Neon) — the CENTRAL database
# Holds users, api keys, canon domains, and the registry of clients and
# projects. Also holds the corpus of every client whose isolation_mode is
# "shared" (the default).
# Pooled connection — used by app runtime
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require&channel_binding=require"
# Direct connection — used by drizzle-kit migrate and admin scripts
DATABASE_URL_UNPOOLED="postgresql://user:pass@host.region.aws.neon.tech/db?sslmode=require&channel_binding=require"

# --- Dedicated client databases -------------------------------------------
# A client whose isolation_mode is "dedicated" keeps its corpus in a database
# of its own. The clients row does NOT store the connection string — it stores
# the NAME of the environment variable holding it (clients.corpus_db_url_env),
# so secrets stay in the deployment environment.
#
# Add one variable per dedicated client, named however you like, and put that
# name in the client's corpus_db_url_env column:
#
#   WORKBRAIN_DB_ACME="postgresql://user:pass@acme-pooler.region.aws.neon.tech/db?sslmode=require"
#
# Two rules the code enforces for you:
#   - A dedicated client whose variable is missing raises an error. It never
#     falls back to the central database.
#   - Each dedicated database needs the same migrations applied as the central
#     one. Run drizzle-kit migrate against it before pointing a client at it.

# Neon control plane (optional)
# Only read by `db:isolate`, and only when it is asked to CREATE a dedicated
# database for a client instead of being handed one with --url. Everything
# else talks to Postgres directly and never needs this.
# Create one at: Neon console -> Account settings -> API keys
NEON_API_KEY=""

# Voyage AI
VOYAGE_API_KEY=""

# Anthropic (declared for Phase 2, unused in Phase 1)
ANTHROPIC_API_KEY=""

# Corpus storage (path to the local markdown corpus, lives in its own git repo)
WORKBRAIN_CORPUS_PATH="../../corpus"
WORKBRAIN_CORPUS_REMOTE="git@github.com:your-username/your-corpus-repo.git"
WORKBRAIN_CORPUS_BRANCH="main"

# Auth
# Generate each with: openssl rand -hex 32
WORKBRAIN_API_KEYS_SALT=""
# Signs the webapp session cookie. `next build` fails at page-data collection
# without it, so it must be set in every environment, not just at runtime.
WORKBRAIN_SESSION_SECRET=""

# Environment
NODE_ENV="development"
