# Hoist drizzle-orm to the root so all workspaces resolve to the same instance.
# Without this, pnpm creates two virtual stores for drizzle-orm (with and without
# the @neondatabase/serverless peer resolved), and TypeScript sees them as
# distinct types — schema imported from packages/shared mismatches queries
# in apps/web. This is a known monorepo+drizzle pattern.
public-hoist-pattern[]=drizzle-orm
public-hoist-pattern[]=@neondatabase/*

# Allow scripts in workspace packages but block transitive postinstall scripts
# unless explicitly approved (default behavior is fine; just being explicit).
